# ---------------------------------------------------------------------------
# AI Lead Qualification API - environment template
# Copy to `.env` and adjust values. NEVER commit the real `.env` file.
# All values below are safe placeholders; replace credentials before deploying.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME="AI Lead Qualification API"
ENVIRONMENT=development
LOG_LEVEL=INFO
# Optional: when set, every /api/v1 request must send header X-API-Key: <value>
# API_KEY=change-me-to-a-long-random-string

# --- Database (PostgreSQL / Supabase) --------------------------------------
# Local Docker Compose default (docker-compose reads this file automatically):
POSTGRES_USER=lead
POSTGRES_PASSWORD=lead
POSTGRES_DB=leads
POSTGRES_PORT=5432
# Used by the API service inside docker-compose:
DATABASE_URL=postgresql+psycopg://lead:lead@localhost:5432/leads
# Supabase example (transaction pooler):
# DATABASE_URL=postgresql+psycopg://postgres.<PROJECT_REF>:<PASSWORD>@aws-0.<REGION>.pooler.supabase.com:6543/postgres
# Set to false once you manage the schema with real migrations:
AUTO_CREATE_SCHEMA=true

# --- Ollama (local AI) -----------------------------------------------------
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_TOKENS=512
# Transient Ollama failures (timeouts, 5xx) are retried this many times
OLLAMA_MAX_RETRIES=2

# --- Notifications (optional outbound webhook) -----------------------------
# When set, every completed qualification POSTs a JSON payload to this URL.
# Never fails the request; delivery is best-effort and logged.
# NOTIFY_WEBHOOK_URL=https://example.com/webhooks/lead-qualified
NOTIFY_TIMEOUT_SECONDS=3.0

# --- Qualification tuning --------------------------------------------------
# How much weight the AI score gets vs. the deterministic rules score (0..1)
AI_BLEND_WEIGHT=0.6
# Score thresholds used to map a 0-100 score to a decision
QUALIFIED_THRESHOLD=70
NURTURE_THRESHOLD=40
# Leads declaring a budget below this value are hard-disqualified
MIN_BUDGET=1000

# JSON arrays (must be valid JSON when set through the environment)
TARGET_INDUSTRIES=["saas","software","ecommerce","fintech","healthtech","agency","logistics"]
TARGET_COUNTRIES=["US","GB","CA","AU","IE","DE","FR","NL","CH","SE","SG","AE"]
FREE_EMAIL_DOMAINS=["gmail.com","yahoo.com","hotmail.com","outlook.com","icloud.com","aol.com","proton.me","protonmail.com","gmx.com","mail.com"]
